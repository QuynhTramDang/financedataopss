# ─────────────────────────────────────────────────────────────
# Impact-Aware Finance DataOps Twin — environment config
# Copy file này thành `.env` và điền giá trị thật.
# ─────────────────────────────────────────────────────────────

# Claude — dùng cho planner / root cause / patch review / RCA / claim split
# (Phase 1: model mạnh cho reasoning, model rẻ hơn cho task nhỏ)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
ANTHROPIC_PLANNER_MODEL=claude-opus-4-8
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001

# Model nhỏ qua endpoint OpenAI-compatible (tùy chọn).
# Nếu bỏ trống, route "classifier" sẽ fallback sang Claude small model ở trên.
# Ví dụ chạy local bằng Ollama:
#   SMALL_MODEL_BASE_URL=http://localhost:11434/v1
#   SMALL_MODEL_API_KEY=ollama
#   SMALL_MODEL_NAME=qwen2.5:3b
SMALL_MODEL_BASE_URL=
SMALL_MODEL_API_KEY=
SMALL_MODEL_NAME=

# ─────────────────────────────────────────────────────────────
# GreenNode MaaS — model chạy khi DEPLOY lên AgentBase (Claw-a-thon)
# Endpoint OpenAI-compatible; API Key + base URL lấy từ email/portal của BTC.
# Provider "maas" trong models.yaml dùng 3 biến này.
#   MAAS_BASE_URL : base URL OpenAI-compatible (kiểm tra portal — thường .../v1)
#   MAAS_API_KEY  : API Key MaaS (BTC gửi qua email)
#   MAAS_MODEL    : id model — ví dụ gemma / qwen / minimax (chọn theo use case)
# Lưu ý: KHÔNG set GREENNODE_CLIENT_ID/SECRET/AGENT_IDENTITY ở đây —
#        AgentBase Runtime tự inject khi container chạy.
MAAS_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
MAAS_API_KEY=
MAAS_MODEL=

# Database (SQLite, file-based)
DATABASE_PATH=database/finance_dataops.db

# ─────────────────────────────────────────────────────────────
# MCP integration (M1+) — bật RealMCPTransport thay FakeTransport.
# KHÔNG set gì → hệ chạy FakeTransport offline (test/CI không cần Docker/server).
# Airflow: chạy `docker compose -f docker/airflow/docker-compose.yaml up` trước.
#   AIRFLOW_MCP_ENABLED=1
#   AIRFLOW_BASE_URL=http://localhost:8080/api/v1
#   AIRFLOW_USERNAME=admin
#   AIRFLOW_PASSWORD=admin
#   AIRFLOW_MCP_CMD=uvx
#   AIRFLOW_MCP_ARGS=mcp-server-apache-airflow
# GitLab (M2) — token scope `api`, project test trên gitlab.com:
#   GITLAB_MCP_ENABLED=1
#   GITLAB_TOKEN=glpat-...           # KHÔNG commit; chỉ trong .env (đã .gitignore)
#   GITLAB_PROJECT_ID=123456         # numeric id (Settings → General)
#   GITLAB_API_URL=https://gitlab.com/api/v4
#   GITLAB_MCP_CMD=python            # server local tự viết (không cần npx)
#   GITLAB_MCP_ARGS=scripts/gitlab_mcp_server.py
# Teams (M2, notify):
#   TEAMS_WEBHOOK_URL=https://...
